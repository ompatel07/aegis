# ─────────────────────────────────────────────────────────────────────────────
# Aegis orchestrator (scan worker) configuration.
# ─────────────────────────────────────────────────────────────────────────────

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
ENVIRONMENT=development

# Database
DATABASE_URL=postgres://aegis:aegis@localhost:5432/aegis?sslmode=disable
DB_MAX_OPEN_CONNS=15
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=30

# Redis / Asynq queue
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# Number of concurrent scan jobs this worker will process.
WORKER_CONCURRENCY=5

# Scanner service base URL (internal network).
SCANNER_BASE_URL=http://localhost:8000
# Per-scanner-call timeout (seconds). Builds/SAST can be slow on large repos.
SCANNER_TIMEOUT_SECONDS=900

# Working directory where repos are cloned and deleted after scanning.
WORKSPACE_DIR=/tmp/aegis-workspaces
# Max repo size to clone (MB); larger repos are rejected to protect the worker.
MAX_REPO_SIZE_MB=512
# Git clone depth (shallow clone for speed). 0 = full history.
GIT_CLONE_DEPTH=1
