# ─────────────────────────────────────────────────────────────────────────────
# Aegis scanner (Python / FastAPI) configuration.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP server
SCANNER_HOST=0.0.0.0
SCANNER_PORT=8000
# Uvicorn workers. Keep at 1 in dev; scale via replicas in production.
WEB_CONCURRENCY=1

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
ENVIRONMENT=development

# Tool binaries (must be on PATH inside the container image).
SEMGREP_BIN=semgrep
TRIVY_BIN=trivy
GITLEAKS_BIN=gitleaks

# Semgrep rule registries (comma-separated). Language packs + Aegis's own custom
# taint rulesets (rules/taint/) are added per-scan on top of these.
SEMGREP_BASE_CONFIGS=p/owasp-top-ten,p/r2c-security-audit,p/default,p/secrets,p/supply-chain,p/cwe-top-25
# Cache dir so Semgrep/Trivy don't re-download rules/DBs each run.
SEMGREP_RULES_CACHE=/opt/aegis/cache/semgrep
TRIVY_CACHE_DIR=/opt/aegis/cache/trivy

# Per-tool subprocess timeouts (seconds).
SEMGREP_TIMEOUT_SECONDS=600
TRIVY_TIMEOUT_SECONDS=600
GITLEAKS_TIMEOUT_SECONDS=300
QUALITY_TIMEOUT_SECONDS=300
DEPLOYMENT_TIMEOUT_SECONDS=900

# Deployment engine: allow running the project's build commands.
# Disable in hardened environments where arbitrary build execution is unwanted.
DEPLOYMENT_BUILD_ENABLED=true
