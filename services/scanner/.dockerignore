# Keep the build context small; never ship the local virtualenv or caches.
.venv
venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
# Anchor to the context root so we don't accidentally drop the smoke fixture's
# tests/fixtures/vulnerable_app/.env (Gitleaks/Trivy need it).
/.env
.git
.dockerignore
Dockerfile
# Belt-and-suspenders: always keep test fixtures in the build context.
!tests/fixtures/**
