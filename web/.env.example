# ─────────────────────────────────────────────────────────────────────────────
# Aegis web dashboard (Next.js 14) configuration.
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets there.
# ─────────────────────────────────────────────────────────────────────────────

# Public API base URL (browser → nginx → api). Versioned.
NEXT_PUBLIC_API_URL=http://localhost/api/v1

# Server-side API base URL used by NextAuth / route handlers (container network).
API_INTERNAL_URL=http://api:8080/api/v1

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=dev-nextauth-secret-change-me
NEXTAUTH_URL=http://localhost

# App metadata
NEXT_PUBLIC_APP_NAME=Aegis
